						'about.label': '关于',
						'about.title': '关于',
						'about.body':
							'我有 AI 视觉检测的实践经验。现在把对业务问题的理解，带到自己的软件与工具创作里——从实际问题出发，做出有用的东西。',
						'contact.label': '联系',
						'contact.title': '联系',
