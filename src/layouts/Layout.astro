						'hero.pitch': 'Useful software, grounded in real problems.',
						'hero.bio':
							'With hands-on experience in AI vision inspection, I’m bringing business-problem sense into my own software and tools.',
						'hero.cta.primary': 'Talk about a problem',
						'hero.cta.secondary': 'About me',
						'hero.visual.caption': '無為 / WU WEI',
						'works.label': 'Works',
						'works.title': 'Works',
						'works.intro': 'Start from a real path walked; software comes next.',
						'works.item0.kicker': 'Tool · Open source',
						'works.item0.title': 'Vision Promise Boundary',
						'works.item0.desc': 'Before promising speed / false-positive / takt claims, run a reject-and-boundary checklist. A alignment tool for plant owners, delivery, and sales—not a YOLO demo.',
						'works.item0.cta': 'Try online →',
						'works.item1.kicker': 'Tool · Open source',
