---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container footer-inner">
		<p>© {year} 吴小为 / Wei Wu. Built with Astro.</p>
		<a href="#top">回到顶部</a>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--border);
		padding: 1.5rem 0 2.5rem;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.footer a:hover {
		color: var(--accent-strong);
	}
</style>
