---
const base = import.meta.env.BASE_URL;
---

<section class="hero section" id="top">
	<div class="container hero-grid">
		<div class="hero-copy">
			<h1 class="hero-title" data-i18n="hero.name">無為 · Wu Wei</h1>
			<p class="hero-pitch" data-i18n="hero.pitch">从实际问题出发，做有用的软件。</p>
			<p class="hero-bio" data-i18n="hero.bio">
				我有 AI 视觉检测的实践经验，正在把对业务问题的理解，带进自己的软件和工具创作中。
			</p>
			<div class="hero-actions">
				<a class="button" href="mailto:luwuwei328@gmail.com" data-i18n="hero.cta.primary">聊聊你遇到的问题</a>
				<a class="button button-ghost" href="#about" data-i18n="hero.cta.secondary">了解我的经历</a>
			</div>
		</div>
		<aside class="hero-visual" aria-label="Signature">
			<div class="visual-frame">
				<img
					class="visual-photo"
					src={`${base}avatar.jpg`}
					alt="無為 / Wu Wei"
					width="640"
					height="800"
					decoding="async"
				/>
				<div class="visual-veil" aria-hidden="true"></div>
				<p class="visual-signature" data-i18n="hero.visual.caption">無為 / WU WEI</p>
			</div>
		</aside>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(3rem, 7vw, 4.75rem);
		padding-bottom: clamp(3rem, 8vw, 5rem);
	}

	.hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 900px) {
		.hero-grid {
			grid-template-columns: 1.05fr 0.95fr;
			gap: 3.5rem;
		}
	}

	.hero-title {
		margin: 0 0 1rem;
		font-size: clamp(2.6rem, 7vw, 3.8rem);
		line-height: 1.12;
		letter-spacing: -0.035em;
		font-weight: 700;
		color: var(--accent-strong);
	}

	.hero-pitch {
		margin: 0 0 1rem;
		max-width: 28rem;
		font-size: clamp(1.2rem, 2.6vw, 1.45rem);
		line-height: 1.45;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.hero-bio {
		margin: 0 0 1.75rem;
		max-width: 34rem;
		color: var(--text-muted);
		font-size: 1.02rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero-visual {
		justify-self: stretch;
	}

	.visual-frame {
		position: relative;
		overflow: hidden;
		border-radius: 1.25rem;
		border: 1px solid var(--border);
		aspect-ratio: 4 / 5;
		max-height: 520px;
		background: var(--bg-elevated);
		box-shadow: var(--shadow);
	}

	.visual-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 18%;
		filter: grayscale(0.15) contrast(1.05);
		transform: scale(1.08);
	}

	.visual-veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, transparent 42%, rgba(11, 13, 16, 0.88) 100%),
			linear-gradient(90deg, rgba(11, 13, 16, 0.35), transparent 40%);
		pointer-events: none;
	}

	.visual-signature {
		position: absolute;
		left: 1.15rem;
		bottom: 1.1rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: clamp(0.95rem, 2.2vw, 1.15rem);
		font-weight: 500;
		letter-spacing: 0.18em;
		color: var(--accent-strong);
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
	}

	@media (max-width: 899px) {
		.visual-frame {
			max-width: 360px;
			margin-inline: auto;
		}
	}
</style>
