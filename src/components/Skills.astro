---
const skills = [
	{
		title: '构建与交付',
		items: ['把想法做成可运行软件', '小步发布与版本节奏', '文档、README 与可复现环境'],
	},
	{
		title: '产品感觉',
		items: ['问题定义与取舍', '面向真实用户的体验', '独立产品从 0 到可用'],
	},
	{
		title: 'AI 应用实验',
		items: ['把模型能力嵌进具体工作流', '快速原型与验证', '不写企业工业清单，只做能跑的东西'],
	},
	{
		title: '开放协作',
		items: ['公开仓库与 issue', '清晰文档与贡献说明', '欢迎一起做有意思的项目'],
	},
];
---

<section class="section" id="skills">
	<div class="container">
		<p class="section-label">能力与关注</p>
		<h2 class="section-title">独立开发者在练的事</h2>
		<p class="section-lead">
			重心在「做出并公开交付软件」：产品判断、工程落地、AI 实验，以及能和别人一起协作的开源习惯。
		</p>
		<div class="skills-grid">
			{
				skills.map((skill) => (
					<article class="card">
						<h3>{skill.title}</h3>
						<ul>
							{skill.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.skills-grid {
		display: grid;
		gap: 1rem;
		margin-top: 2rem;
	}

	@media (min-width: 720px) {
		.skills-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.card h3 {
		margin: 0 0 0.85rem;
		font-size: 1.15rem;
		color: var(--accent-strong);
	}

	.card ul {
		margin: 0;
		padding-left: 1.1rem;
		color: var(--text-muted);
	}

	.card li + li {
		margin-top: 0.4rem;
	}
</style>
