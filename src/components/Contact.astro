<section class="section" id="contact">
	<div class="container">
		<div class="contact-panel">
			<div>
				<p class="section-label">联系</p>
				<h2 class="section-title">一起做点有意思的东西</h2>
				<p class="section-lead">
					合作、开源讨论，或只是打个招呼——欢迎邮件或在 GitHub 找我。Get in touch.
				</p>
			</div>
			<div class="contact-actions">
				<a class="button" href="mailto:luwuwei328@gmail.com">luwuwei328@gmail.com</a>
				<a
					class="button button-ghost"
					href="https://github.com/bianwuwei"
					target="_blank"
					rel="noopener noreferrer"
				>
					GitHub · bianwuwei
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-panel {
		display: grid;
		gap: 1.5rem;
		padding: clamp(1.5rem, 4vw, 2.4rem);
		border-radius: calc(var(--radius) + 6px);
		border: 1px solid rgba(245, 165, 36, 0.28);
		background:
			linear-gradient(135deg, rgba(245, 165, 36, 0.14), transparent 50%),
			var(--bg-elevated);
		box-shadow: var(--shadow);
	}

	@media (min-width: 800px) {
		.contact-panel {
			grid-template-columns: 1.4fr 1fr;
			align-items: center;
		}
	}

	.contact-actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.contact-actions .button {
		width: 100%;
	}
</style>
