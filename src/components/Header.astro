---
const base = import.meta.env.BASE_URL;
---

<header class="header">
	<div class="container header-inner">
		<a class="logo" href={base}>
			<span class="logo-mark" aria-hidden="true">無</span>
			<span class="logo-text">無為 <em>Wu Wei</em></span>
		</a>
		<nav class="nav" aria-label="Primary">
			<a href="#works" data-i18n="nav.works">作品</a>
			<a href="#about" data-i18n="nav.about">关于</a>
			<a href="#contact" data-i18n="nav.contact">联系</a>
		</nav>
		<div class="lang-toggle" role="group" aria-label="Language">
			<button type="button" class="lang-btn is-active" data-lang-btn="zh" aria-pressed="true" data-i18n="nav.lang.zh">中文</button>
			<span class="lang-sep" aria-hidden="true">|</span>
			<button type="button" class="lang-btn" data-lang-btn="en" aria-pressed="false" data-i18n="nav.lang.en">EN</button>
		</div>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(14px);
		background: rgba(11, 13, 16, 0.78);
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 3.75rem;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.logo-mark {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 0.55rem;
		background: var(--accent);
		color: #1a1205;
		font-weight: 800;
		font-size: 0.8rem;
	}

	.logo-text em {
		margin-left: 0.3rem;
		font-style: normal;
		font-weight: 500;
		color: var(--text-muted);
		font-size: 0.82em;
	}

	.nav {
		display: none;
		gap: 1.35rem;
	}

	.nav a {
		color: var(--text-muted);
		font-size: 0.92rem;
		font-weight: 500;
	}

	.nav a:hover {
		color: var(--accent-strong);
	}

	.lang-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}

	.lang-btn {
		appearance: none;
		border: 0;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		padding: 0.2rem 0.15rem;
		font: inherit;
	}

	.lang-btn:hover {
		color: var(--text);
	}

	.lang-btn.is-active {
		color: var(--accent-strong);
		font-weight: 700;
	}

	.lang-sep {
		color: var(--border);
		user-select: none;
	}

	@media (min-width: 720px) {
		.nav {
			display: flex;
		}
	}
</style>
